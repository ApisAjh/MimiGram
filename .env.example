# === App ===
SESSION_TTL_HOURS=168
NODE_ENV=production
ALLOWED_ORIGIN=https://your-app.vercel.app

# Optional limits
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=52428800
