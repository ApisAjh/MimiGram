# === Telegram (SECRET - backend only) ===
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=https://your-app.vercel.app
TELEGRAM_AUTH_MAX_AGE=86400

# === Supabase ===
SUPABASE_URL=https://xxxx.supabase.co
